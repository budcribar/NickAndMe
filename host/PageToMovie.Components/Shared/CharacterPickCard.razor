@namespace PageToMovie.Web.Components

<div class="char-pick__card @(Selected ? "is-chosen" : null)"
     data-testid="@(TestId ?? "char-pick-card")"
     @onclick="OnSelect">
    <div class="char-pick__frame">
        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <img src="@ImageUrl" alt="@Label" />
        }
        else
        {
            <span class="text-muted small">No image</span>
        }
    </div>
    <span class="char-pick__label">@Label</span>
    @if (ShowUseButton)
    {
        <button type="button"
                class="btn btn-sm btn-primary char-pick__use"
                @onclick:stopPropagation="true"
                @onclick="OnUse">
            @UseLabel
        </button>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public bool Selected { get; set; }
    [Parameter] public bool ShowUseButton { get; set; } = true;
    [Parameter] public string UseLabel { get; set; } = "Use";
    [Parameter] public EventCallback OnSelect { get; set; }
    [Parameter] public EventCallback OnUse { get; set; }
    [Parameter] public string? TestId { get; set; }
}
