@namespace PageToMovie.Web.Components

<div class="card @BorderClass @CssClass" data-testid="@TestId" @attributes="AdditionalAttributes">
    @if (!string.IsNullOrWhiteSpace(Title) || Actions is not null)
    {
        <div class="card-header py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <span class="fw-semibold">@Title</span>
            }
            else
            {
                <span></span>
            }
            @if (Actions is not null)
            {
                <div class="d-flex flex-wrap gap-2">@Actions</div>
            }
        </div>
    }
    <div class="card-body @BodyClass">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string BorderClass { get; set; } = "border-secondary";
    [Parameter] public string CssClass { get; set; } = "mb-3";
    [Parameter] public string BodyClass { get; set; } = "";
    [Parameter] public string? TestId { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
